# ── Бинарники ──
/bin/
/numaestra
/numaestra.exe
*.exe

# ── Секреты / окружение ──
.env
.env.*
!.env.example

# ── Логи и временные файлы ──
*.log
tmp_*
*.tmp

# ── Покрытие тестами и профили Go ──
*.out
cov_func.txt
coverage
coverage-*
coverage_*

# ── Редакторы / ОС ──
.idea/
.DS_Store
Thumbs.db

# ── Frontend ──
frontend/.env
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# ── Vite build output ──
# Регенерируется `npm run build` при сборке Docker. В git держим только
# placeholder web/out/index.html, чтобы локальный `go build` (//go:embed out)
# собирался без запуска фронта.
/web/out/*
!/web/out/index.html

# Артефакты веб-скрейпинга (firecrawl)
.firecrawl/

# Go coverage profiles (артефакты go test -coverprofile)
cov
coverage.out
