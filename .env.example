# Окружение приложения: dev | staging | production
# В dev включается цветной neon-логгер и уровень Debug.
APP_ENV=dev

# --- HTTP ---
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL ---
POSTGRES_DSN=postgres://numaestra:numaestra@localhost:5432/numaestra?sslmode=disable

# --- Redis (Asynq) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- Robokassa ---
ROBOKASSA_MERCHANT_LOGIN=numaestra_test
ROBOKASSA_PASS1=test_pass1
ROBOKASSA_PASS2=test_pass2
ROBOKASSA_IS_TEST=true

# --- Suno (через реселлера/прокси API) ---
SUNO_API_URL=https://api.custom-suno.local
SUNO_API_KEY=

# --- S3-совместимое хранилище треков ---
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=numaestra-tracks
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- LLM (OpenRouter по умолчанию) ---
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# --- Прайс (цену определяет сервер, клиент выбирает только тариф) ---
PRICE_STANDARD_KOPECKS=150000
PRICE_PREMIUM_KOPECKS=290000
PRICE_DEFAULT_PLAN=standard

# --- SMTP (email-уведомления о готовности заказа) ---
# Оставьте SMTP_HOST пустым чтобы использовать заглушку-логгер вместо реальной отправки.
# Поддерживаются любые SMTP-провайдеры: Mailgun, Yandex 360, SendGrid, Postmark и т.д.
# Порт 587 — STARTTLS, порт 465 — implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@numaestra.ru
SMTP_FROM_NAME=Numaestra

# --- Admin API ---
# Bearer-токен для защиты /api/v1/admin/* маршрутов.
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# --- Шифрование сессий Suno (AES-256-GCM) ---
# 64 hex-символа = 32 байта. Обязателен в prod, в dev используется небезопасный дев-ключ.
# Сгенерировать: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
