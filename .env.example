# Окружение приложения: dev | staging | production
# В dev включается цветной neon-логгер и уровень Debug.
APP_ENV=dev
# Для non-dev деплоя включайте минимум: proxy,monitoring,backup
# (deploy.sh остановит деплой, если monitoring/backup отключены).
COMPOSE_PROFILES=proxy,monitoring,backup

# --- HTTP ---
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL ---
POSTGRES_DSN=postgres://numaestra:numaestra@localhost:5432/numaestra?sslmode=disable
# Пароль БД для docker-compose (подставляется в POSTGRES_DSN внутри сети).
# В prod ОБЯЗАТЕЛЬНО задайте надёжный пароль (openssl rand -hex 24).
POSTGRES_PASSWORD=numaestra

# --- Redis (Asynq) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- Robokassa ---
# В prod (APP_ENV != dev) логин и пароли ОБЯЗАТЕЛЬНЫ и не должны совпадать с
# этими тестовыми заглушками — иначе подпись вебхука оплаты подделываема и
# приложение откажется стартовать.
ROBOKASSA_MERCHANT_LOGIN=numaestra_test
ROBOKASSA_PASS1=test_pass1
ROBOKASSA_PASS2=test_pass2
# Password3 — отдельный пароль для API возвратов (генерируется в кабинете Robokassa).
ROBOKASSA_PASS3=
ROBOKASSA_IS_TEST=true
# Обязательно в prod (не пусто!). Только IP Robokassa — не 172.16.0.0/12.
# Пример prod: ROBOKASSA_ALLOWED_IPS=185.59.216.65,185.59.217.65
ROBOKASSA_ALLOWED_IPS=

# --- Suno (провайдер TTAPI, https://docs.ttapi.io/api/en/suno) ---
# URL — корень API. Ключ из дашборда ttapi.io уходит в заголовок TT-API-KEY.
SUNO_API_URL=https://api.ttapi.io
SUNO_API_KEY=
# Модель Suno (параметр mv). chirp-v5-5 = Suno v5.5 (рекомендуется).
SUNO_MODEL=chirp-v5-5

# --- S3-совместимое хранилище треков ---
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=numaestra-tracks
S3_ACCESS_KEY=
S3_SECRET_KEY=
# CDN: база ПУБЛИЧНЫХ ссылок на объекты (только чтение). Загрузка/удаление всё
# равно идут на S3_ENDPOINT — CDN не принимает PUT/DELETE. Пусто → ссылки вида
# {S3_ENDPOINT}/{S3_BUCKET}/{key} (без CDN). При включении новые треки получают
# CDN-ссылки; старые продолжают работать по прямым S3-ссылкам (удаление демо
# понимает оба домена). Чтобы и старые ссылки шли через CDN — разовая миграция
# deploy/cdn-migrate-urls.sql. Формат под маппинг CDN:
#   origin = бакет (virtual-hosted):  https://cdn.numaestra.ru
#   origin = path-style:              https://cdn.numaestra.ru/numaestra-tracks
S3_PUBLIC_BASE_URL=

# --- LLM (OpenRouter / ChatGPT) — сейчас НЕ используется, тексты пишет Suno ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=

# --- Цена (фиксированная, без тарифов и подписок: 4 версии песни за платёж) ---
PRICE_KOPECKS=200000

# --- SMTP (email-уведомления о готовности заказа) ---
# Оставьте SMTP_HOST пустым чтобы использовать заглушку-логгер вместо реальной отправки.
# RuSender: https://rusender.ru/knowledge-base/email-service/email-api/kak-nachat-rabotu-s-smtp/
# Порт 587 — STARTTLS (наш код), порт 465 — implicit TLS (тоже поддерживается).
# SMTP_PASSWORD — пароль SMTP-подключения из личного кабинета RuSender, не пароль почты.
SMTP_HOST=smtp.rusender.ru
SMTP_PORT=587
SMTP_USER=noreply@numaestra.ru
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@numaestra.ru
SMTP_FROM_NAME=Numaestra
# Адрес для ответов клиента (пустой → support@ваш-домен).
SMTP_REPLY_TO=support@numaestra.ru
# Публичный URL сайта для ссылок в письмах (без слэша на конце).
# Обязателен при включённом SMTP: ссылки в письмах /status/{uuid}?token=... (path переживает click-tracking RuSender).
PUBLIC_APP_URL=https://numaestra.ru
# Email администратора для служебных уведомлений: новая оплата, готовое демо,
# провал генерации. Письма уходят сюда (а не клиенту). Пусто → не отправляются.
# Работает только при включённом SMTP_HOST.
ADMIN_NOTIFY_EMAIL=
# Для доставки во «Входящие» в RuSender подтвердите домен и добавьте DNS:
# SPF (include:rsndr.ru), DKIM (mdmdmail._domainkey), DMARC (_dmarc).
# Инструкция: https://rusender.ru/knowledge-base/email-service/domains-senders/podtverzhdenie-domena-dlya-email-rassylok/

# --- Admin API ---
# Bearer-токен для защиты /api/v1/admin/* маршрутов (скрипты/CI/curl).
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# Логин/пароль для входа в /admin на фронтенде (POST /api/v1/admin/login).
# Пароль проверяется через bcrypt; неудачные попытки залогированы и жёстко
# ограничены по частоте (rate-limit на /admin/login).
# ADMIN_PASSWORD можно задать двумя способами:
#   • bcrypt-хэш ($2a$.../$2b$.../$2y$...) — РЕКОМЕНДУЕТСЯ для prod: в env нет
#     открытого пароля, при утечке конфига пароль не восстановить.
#     Сгенерировать: docker run --rm httpd:alpine htpasswd -bnBC 12 "" 'вашпароль' | tr -d ':\n'
#   • открытый пароль — приложение само захэширует на старте (удобно для dev).
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Секрет, которым подписываются cookie-сессии админки (HMAC-SHA256, см. pkg/adminsession).
# 64 hex-символа = 32 байта. Обязателен в prod, в dev используется небезопасный дев-ключ.
# Сгенерировать: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Шифрование сессий Suno (AES-256-GCM) ---
# 64 hex-символа = 32 байта. Обязателен в prod, в dev используется небезопасный дев-ключ.
# Сгенерировать: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# --- CORS / метрики ---
# Домены, которым разрешён доступ к API (пусто = "*", только для dev).
CORS_ALLOWED_ORIGINS=
# CIDR-блоки, которым разрешён доступ к /metrics.
METRICS_ALLOWED_IPS=127.0.0.1/8,::1/128,172.16.0.0/12

# --- Reverse-proxy / TLS (Caddy, profile "proxy") ---
# Домен, на который будет выпущен Let's Encrypt сертификат, и email для ACME.
# Запуск: docker compose --profile proxy up -d (см. deploy/Caddyfile).
DOMAIN=
ACME_EMAIL=

# --- Бэкапы Postgres (profile "backup") ---
# Запуск: docker compose --profile backup up -d (см. deploy/backup-postgres.sh).
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
# Offsite-копия в S3-совместимое хранилище (обязательно для non-dev деплоя).
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Алерты Alertmanager (profile "monitoring") ---
# Конфиг Alertmanager рендерится из этих переменных при старте
# (init-сервис alertmanager-config, см. deploy/render-alertmanager.sh).
# Email уходит через те же SMTP_* выше — задайте лишь получателя:
ALERT_EMAIL_TO=
# Опционально — дублировать алерты в Telegram (оба поля обязательны для канала):
# токен бота от @BotFather и chat_id (для группы — отрицательный, через @getidsbot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Для non-dev деплоя обязателен хотя бы один канал (email или Telegram),
# иначе deploy.sh остановит выкладку.
